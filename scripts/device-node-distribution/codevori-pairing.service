[Unit]
Description=CodeVori device enrollment and transient MCP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codevori-pairing
Group=codevori-pairing
EnvironmentFile=/etc/codevori-pairing.env
ExecStart=/opt/codevori-pairing/codevori-pairing
Restart=on-failure
RestartSec=3
StateDirectory=codevori-pairing
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codevori-pairing

[Install]
WantedBy=multi-user.target
