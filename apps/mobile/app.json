{
  "expo": {
    "name": "ZCode LAN Mobile",
    "slug": "zcode-lan-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "zcode-lan-mobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.zcode.lanmobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "用于连接同一局域网内运行的 ZCode Web 服务。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "ai.zcode.lanmobile"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
